# Port website (dipakai saat run lokal: npm run dev)
PORT=3000

# Ganti dengan string acak yang panjang & rahasia
SESSION_SECRET=ganti-dengan-string-acak-panjang

# --- DATABASE (Turso / libSQL) ---
# WAJIB diisi untuk deploy ke Vercel (filesystem Vercel tidak persisten,
# jadi SQLite file lokal TIDAK BISA dipakai di production).
# 1. Buat akun & database gratis di https://turso.tech
# 2. `turso db create host-scheduler`
# 3. `turso db show host-scheduler --url` -> isi TURSO_DATABASE_URL
# 4. `turso db tokens create host-scheduler` -> isi TURSO_AUTH_TOKEN
# Kalau dikosongkan saat run lokal, otomatis fallback ke file data.sqlite lokal.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Akun HR/admin pertama, dibuat otomatis saat database pertama kali dibuat.
# Setelah login pertama kali, sebaiknya ganti password lewat database/atur ulang.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Sampai 5 API key Groq (buat di https://console.groq.com/keys).
# Sistem akan otomatis pindah ke key berikutnya kalau satu key kena rate-limit.
# Cukup isi minimal 1, sisanya boleh dikosongkan.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=

# Model Groq yang dipakai (default llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile
